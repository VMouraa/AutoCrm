# Caminho na mesma origem: usa o proxy do Vite em desenvolvimento.
# URLs externas não são aceitas pelo cliente de sessão.
VITE_API_BASE_URL=/api
# Apenas configuração do servidor Vite; não é exposta ao navegador.
DJANGO_PROXY_TARGET=http://127.0.0.1:8000
# No Django, DJANGO_CSRF_TRUSTED_ORIGINS pode configurar outras origens.
# Em DEBUG, 127.0.0.1:5173 e localhost:5173 já são confiáveis para CSRF.
